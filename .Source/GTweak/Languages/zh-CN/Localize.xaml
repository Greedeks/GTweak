    <v:String x:Key="tgl1_sys">提高指针精确度 (鼠标加速)</v:String>
    <v:String x:Key="tgl2_sys">粘滞键与筛选键弹窗</v:String>
    <v:String x:Key="tgl3_sys">Windows Defender、防病毒、SmartScreen 与 VBS</v:String>
