<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dc="clr-namespace:GTweak.Core.DataContracts"
                    xmlns:conv="clr-namespace:GTweak.Converters">

    <conv:RgbToBrushConverter x:Key="RgbToBrushConverter"/>

    <DataTemplate DataType="{x:Type dc:ExportToggleValue}">
        <Grid VerticalAlignment="Center">
            <Border CornerRadius="5" Opacity="0.4" Background="{StaticResource Brush_ShadowOverlay}" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform X="2" Y="3"/>
                </Border.RenderTransform>
            </Border>
            <Border Padding="8,3" CornerRadius="5">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource Brush_Background_Labels_R}"/>
                        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border_Labels_R}"/>
                        <Setter Property="BorderThickness" Value="1"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding State}" Value="True">
                                <Setter Property="Background" Value="{StaticResource Brush_Background_Labels}"/>
                                <Setter Property="BorderBrush" Value="{StaticResource Brush_Separator}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock FontFamily="{StaticResource Jura}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{DynamicResource status_disabled}"/>
                            <Setter Property="Foreground" Value="{StaticResource Brush_Danger_Hover}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="True">
                                    <Setter Property="Text" Value="{DynamicResource status_active}"/>
                                    <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dc:ExportSliderValue}">
        <Grid VerticalAlignment="Center">
            <Border CornerRadius="5" Opacity="0.4" Background="{StaticResource Brush_ShadowOverlay}" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform X="2" Y="3"/>
                </Border.RenderTransform>
            </Border>
            <Border Padding="8,3" CornerRadius="5" Background="{StaticResource Brush_Background_Labels_B}" BorderBrush="{StaticResource Brush_Separator}" BorderThickness="1">
                <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Jura}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush_Accent_B}" VerticalAlignment="Center"/>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dc:ExportColorValue}">
        <Grid VerticalAlignment="Center">
            <Border CornerRadius="5" Opacity="0.4" Background="{StaticResource Brush_ShadowOverlay}" IsHitTestVisible="False">
                <Border.RenderTransform>
                    <TranslateTransform X="2" Y="3"/>
                </Border.RenderTransform>
            </Border>
            <Border Padding="6,3" CornerRadius="5" Background="{StaticResource Brush_Background_TextBox}" BorderBrush="{StaticResource Brush_Border_Description}" BorderThickness="1">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="10" Height="10" CornerRadius="2" BorderBrush="{StaticResource Brush_Border_Description}" BorderThickness="1" Margin="0,0,6,0">
                        <Border.Background>
                            <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                <Binding Path="R"/>
                                <Binding Path="G"/>
                                <Binding Path="B"/>
                            </MultiBinding>
                        </Border.Background>
                    </Border>
                    <TextBlock FontFamily="{StaticResource Jura}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush_TextBlock_Inactivity}" VerticalAlignment="Center">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                <Binding Path="R"/>
                                <Binding Path="G"/>
                                <Binding Path="B"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dc:ExportChecklistValue}">
        <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Right"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Command="{Binding RemoveCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Focusable="False" Margin="2,2">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid>
                                    <Border CornerRadius="5" Opacity="0.4" Background="{StaticResource Brush_ShadowOverlay}" IsHitTestVisible="False">
                                        <Border.RenderTransform>
                                            <TranslateTransform X="2" Y="3"/>
                                        </Border.RenderTransform>
                                    </Border>
                                    <Border x:Name="BadgeBorder" Padding="8,3" CornerRadius="5" Background="{StaticResource Brush_Background_TextBox}" BorderBrush="{StaticResource Brush_Border_Description}" BorderThickness="1">
                                        <TextBlock x:Name="BadgeText" Text="{Binding Label}" FontFamily="{StaticResource Jura}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush_Inactive}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <Border x:Name="Overlay" CornerRadius="5" Background="{StaticResource Brush_Background_Labels_R}" BorderBrush="{StaticResource Brush_Danger_Hover}" BorderThickness="1" Opacity="0" IsHitTestVisible="False"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                        <Setter TargetName="BadgeBorder" Property="Background" Value="{StaticResource Brush_Background_Labels}"/>
                                        <Setter TargetName="BadgeBorder" Property="BorderBrush" Value="{StaticResource Brush_Separator}"/>
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                    </DataTrigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                                        <Setter TargetName="BadgeText" Property="Foreground" Value="{StaticResource Brush_Danger_Hover}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <DataTemplate DataType="{x:Type dc:ExportPackagesValue}">
        <ItemsControl ItemsSource="{Binding Packages}" VerticalAlignment="Center">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel HorizontalAlignment="Right"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="3" ToolTip="{Binding Name}" VerticalAlignment="Center" Width="34" Height="34">
                        <Border CornerRadius="6" Opacity="0.4" Background="{StaticResource Brush_ShadowOverlay}" IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform X="2" Y="3"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border CornerRadius="6" Background="{StaticResource Brush_Background_TextBox}" BorderThickness="1.2">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush_Danger_Hover}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                            <Setter Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" HorizontalAlignment="Center"/>
                        </Border>
                        <Button Command="{Binding RemoveCommand}" Cursor="Hand" Background="Transparent" BorderThickness="0" Focusable="False" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Border x:Name="Overlay" CornerRadius="6" Opacity="0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{StaticResource Brush_Background_Labels_R}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                                            <Setter Property="Background" Value="{StaticResource Brush_Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                        <Border CornerRadius="6" BorderThickness="1.2" Opacity="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="BorderBrush" Value="{StaticResource Brush_Danger_Hover}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                                            <Setter Property="BorderBrush" Value="{StaticResource Brush_Accent}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Overlay" Property="Opacity" Value="1"/>
                                        </Trigger>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True"/>
                                                <Condition Binding="{Binding CanRemove}" Value="False"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter TargetName="Overlay" Property="Opacity" Value="0.16"/>
                                        </MultiDataTrigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DataTemplate>

    <Style x:Key="ExportCard" TargetType="{x:Type HeaderedContentControl}">
        <Setter Property="VerticalAlignment" Value="Top"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type HeaderedContentControl}">
                    <Grid VerticalAlignment="Top">
                        <Border CornerRadius="8" Background="{StaticResource Brush_ShadowOverlay}" IsHitTestVisible="False" Opacity="0.7">
                            <Border.RenderTransform>
                                <TranslateTransform X="2" Y="3"/>
                            </Border.RenderTransform>
                        </Border>
                        <Border Background="{StaticResource Brush_Background_NavPanel}" BorderBrush="{StaticResource Brush_Border_Description}" BorderThickness="1" CornerRadius="8">
                            <StackPanel>
                                <Border Background="{StaticResource Brush_Background_Card}" BorderBrush="{StaticResource Brush_Border_Description}" BorderThickness="0,0,0,1" CornerRadius="8,8,0,0" Padding="12,8">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" Width="6" Height="6" CornerRadius="3" Background="{StaticResource Brush_Accent}" Margin="0,0,8,0" VerticalAlignment="Center">
                                            <Border.CacheMode>
                                                <BitmapCache RenderAtScale="2"/>
                                            </Border.CacheMode>
                                            <Border.Effect>
                                                <DropShadowEffect BlurRadius="15" ShadowDepth="0" Opacity="0.7" Color="{StaticResource Color_Shadow}"/>
                                            </Border.Effect>
                                        </Border>
                                        <TextBlock Grid.Column="1" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" Style="{StaticResource TextDefault}" Foreground="{StaticResource Brush_Highlighted}" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,8,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
                                        <Border Grid.Column="2" CornerRadius="3" Background="{StaticResource Brush_Background}" BorderBrush="{StaticResource Brush_Separator}" BorderThickness="1" Padding="6,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" FontFamily="{StaticResource Jura}" FontSize="11" Foreground="{StaticResource Brush_Accent}"/>
                                        </Border>
                                    </Grid>
                                </Border>
                                <ContentPresenter Margin="8,4,8,8"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>