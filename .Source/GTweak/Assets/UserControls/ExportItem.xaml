<UserControl x:Class="GTweak.Assets.UserControls.ExportItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:dc="clr-namespace:GTweak.Assets.UserControls.DataContracts"
             xmlns:conv="clr-namespace:GTweak.Converters"
             mc:Ignorable="d" x:Name="Root" IsTabStop="False" Focusable="False"
             KeyboardNavigation.TabNavigation="None" SnapsToDevicePixels="True"
             MinHeight="28" Padding="14,0">
    <UserControl.Resources>
        <conv:RgbToBrushConverter x:Key="RgbToBrushConverter"/>

        <DataTemplate DataType="{x:Type dc:ExportToggleValue}">
            <Grid VerticalAlignment="Center">
                <Border CornerRadius="5" Opacity="0.4" Background="{StaticResource Brush_ShadowOverlay}" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform X="2" Y="3"/>
                    </Border.RenderTransform>
                </Border>
                <Border Padding="8,3" CornerRadius="5">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{StaticResource Brush_Background_Labels_R}"/>
                            <Setter Property="BorderBrush" Value="{StaticResource Brush_Border_Labels_R}"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding State}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush_Background_Labels}"/>
                                    <Setter Property="BorderBrush" Value="{StaticResource Brush_Separator}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock FontFamily="{StaticResource Jura}" FontSize="11" FontWeight="Medium" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{DynamicResource status_disabled}"/>
                                <Setter Property="Foreground" Value="{StaticResource Brush_Danger_Hover}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding State}" Value="True">
                                        <Setter Property="Text" Value="{DynamicResource status_active}"/>
                                        <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dc:ExportSliderValue}">
            <Grid VerticalAlignment="Center">
                <Border CornerRadius="5" Opacity="0.4" Background="{StaticResource Brush_ShadowOverlay}" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform X="2" Y="3"/>
                    </Border.RenderTransform>
                </Border>
                <Border Padding="8,3" CornerRadius="5" Background="{StaticResource Brush_Background_Labels_B}" BorderBrush="{StaticResource Brush_Separator}" BorderThickness="1">
                    <TextBlock Text="{Binding Value}" FontFamily="{StaticResource Jura}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush_Accent_B}" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dc:ExportColorValue}">
            <Grid VerticalAlignment="Center">
                <Border CornerRadius="5" Opacity="0.4" Background="{StaticResource Brush_ShadowOverlay}" IsHitTestVisible="False">
                    <Border.RenderTransform>
                        <TranslateTransform X="2" Y="3"/>
                    </Border.RenderTransform>
                </Border>
                <Border Padding="6,3" CornerRadius="5" Background="{StaticResource Brush_Background_TextBox}" BorderBrush="{StaticResource Brush_Border_Description}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="10" Height="10" CornerRadius="2" BorderBrush="{StaticResource Brush_Border_Description}" BorderThickness="1" Margin="0,0,6,0">
                            <Border.Background>
                                <MultiBinding Converter="{StaticResource RgbToBrushConverter}">
                                    <Binding Path="R"/>
                                    <Binding Path="G"/>
                                    <Binding Path="B"/>
                                </MultiBinding>
                            </Border.Background>
                        </Border>
                        <TextBlock FontFamily="{StaticResource Jura}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush_TextBlock_Inactivity}" VerticalAlignment="Center">
                            <TextBlock.Text>
                                <MultiBinding StringFormat="{}{0} · {1} · {2}">
                                    <Binding Path="R"/>
                                    <Binding Path="G"/>
                                    <Binding Path="B"/>
                                </MultiBinding>
                            </TextBlock.Text>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate DataType="{x:Type dc:ExportChecklistValue}">
            <ItemsControl ItemsSource="{Binding Items}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,2" VerticalAlignment="Center">
                            <Border CornerRadius="5" Opacity="0.4" Background="{StaticResource Brush_ShadowOverlay}" IsHitTestVisible="False">
                                <Border.RenderTransform>
                                    <TranslateTransform X="2" Y="3"/>
                                </Border.RenderTransform>
                            </Border>
                            <Border Padding="8,3" CornerRadius="5">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource Brush_Background_TextBox}"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource Brush_Border_Description}"/>
                                        <Setter Property="BorderThickness" Value="1"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource Brush_Background_Labels}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource Brush_Separator}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontFamily="{StaticResource Jura}" FontSize="11" FontWeight="Medium">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="{Binding Label}"/>
                                            <Setter Property="Foreground" Value="{StaticResource Brush_Inactive}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsChecked}" Value="True">
                                                    <Setter Property="Foreground" Value="{StaticResource Brush_Accent}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>
    </UserControl.Resources>

    <Grid MinHeight="28">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0" Text="{Binding Label, ElementName=Root}" Style="{StaticResource TextDefault}" Foreground="{StaticResource Brush_TextBlock_Inactivity}" FontSize="13" VerticalAlignment="Center" Margin="0,0,12,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
        <ContentPresenter Grid.Column="1" Content="{Binding Value, ElementName=Root}" VerticalAlignment="Center"/>
    </Grid>
</UserControl>