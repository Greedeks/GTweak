<UserControl x:Class="GTweak.Assets.UserControls.TaskbarPositionPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" x:Name="Root" Width="48" Height="40" 
             SnapsToDevicePixels="True" UseLayoutRounding="True" BorderBrush="{StaticResource Brush_Separator}">
    <Viewbox Stretch="Uniform">
        <Grid Margin="3">
            <Rectangle RadiusX="7" RadiusY="7" Fill="{StaticResource Brush_ShadowOverlay}" Opacity="0.7">
                <Rectangle.RenderTransform>
                    <TranslateTransform X="1.5" Y="1.5"/>
                </Rectangle.RenderTransform>
            </Rectangle>

            <Grid Width="46" Height="36">
                <Rectangle RadiusX="7" RadiusY="7" Stroke="{Binding BorderBrush, ElementName=Root}" StrokeThickness="1" Fill="{StaticResource Brush_Background_ComboBox}" IsHitTestVisible="False"/>
                <Path Data="M 0,0 L 23,18 L 0,36 Z" Tag="0" Fill="Transparent" Cursor="Hand" MouseLeftButtonDown="Sector_MouseLeftButtonDown"/>
                <Path Data="M 0,0 L 46,0 L 23,18 Z" Tag="1" Fill="Transparent" Cursor="Hand" MouseLeftButtonDown="Sector_MouseLeftButtonDown"/>
                <Path Data="M 46,0 L 23,18 L 46,36 Z" Tag="2" Fill="Transparent" Cursor="Hand" MouseLeftButtonDown="Sector_MouseLeftButtonDown"/>
                <Path Data="M 0,36 L 46,36 L 23,18 Z" Tag="3" Fill="Transparent" Cursor="Hand" MouseLeftButtonDown="Sector_MouseLeftButtonDown"/>
                
                <Grid IsHitTestVisible="False">
                    <Rectangle Fill="{StaticResource Brush_Separator}" RadiusX="1.25" RadiusY="1.25" Width="2.5" Height="9" HorizontalAlignment="Left" Margin="3.5,0,0,0"/>
                    <Rectangle Fill="{StaticResource Brush_Separator}" RadiusX="1.25" RadiusY="1.25" Width="12" Height="2.5" VerticalAlignment="Top" Margin="0,3.5,0,0"/>
                    <Rectangle Fill="{StaticResource Brush_Separator}" RadiusX="1.25" RadiusY="1.25" Width="2.5" Height="9" HorizontalAlignment="Right" Margin="0,0,3.5,0"/>
                    <Rectangle Fill="{StaticResource Brush_Separator}" RadiusX="1.25" RadiusY="1.25" Width="12" Height="2.5" VerticalAlignment="Bottom" Margin="0,0,0,3.5"/>
                    <Rectangle x:Name="PositionIndicator" Fill="{StaticResource Brush_Accent}" RadiusX="1.25" RadiusY="1.25" RenderTransformOrigin="0.5, 0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Width" Value="12"/>
                                <Setter Property="Height" Value="2.5"/>
                                <Setter Property="Margin" Value="0,0,0,3.5"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="0">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Width" Value="2.5"/>
                                        <Setter Property="Height" Value="9"/>
                                        <Setter Property="Margin" Value="3.5,0,0,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="1">
                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Width" Value="12"/>
                                        <Setter Property="Height" Value="2.5"/>
                                        <Setter Property="Margin" Value="0,3.5,0,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="2">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Width" Value="2.5"/>
                                        <Setter Property="Height" Value="9"/>
                                        <Setter Property="Margin" Value="0,0,3.5,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="3">
                                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Width" Value="12"/>
                                        <Setter Property="Height" Value="2.5"/>
                                        <Setter Property="Margin" Value="0,0,0,3.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <Grid Width="28" Height="18">
                        <Rectangle RadiusX="3" RadiusY="3" Stroke="{StaticResource Brush_Separator}" StrokeThickness="1.5"/>
                        <Rectangle x:Name="TaskbarIndicator" Fill="{StaticResource Brush_Accent}" RenderTransformOrigin="0.5, 0.5" RadiusX="1.5" RadiusY="1.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform/>
                            </Rectangle.RenderTransform>
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="Height" Value="3"/>
                                    <Setter Property="Width" Value="Auto"/>
                                    <Setter Property="Margin" Value="2,0,2,2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="0">
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Height" Value="Auto"/>
                                            <Setter Property="Width" Value="3"/>
                                            <Setter Property="Margin" Value="2,2,0,2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="1">
                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="Height" Value="3"/>
                                            <Setter Property="Width" Value="Auto"/>
                                            <Setter Property="Margin" Value="2,2,2,0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="2">
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Height" Value="Auto"/>
                                            <Setter Property="Width" Value="3"/>
                                            <Setter Property="Margin" Value="0,2,2,2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="3">
                                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="Height" Value="3"/>
                                            <Setter Property="Width" Value="Auto"/>
                                            <Setter Property="Margin" Value="2,0,2,2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Grid>

                </Grid>
            </Grid>
        </Grid>
    </Viewbox>
</UserControl>