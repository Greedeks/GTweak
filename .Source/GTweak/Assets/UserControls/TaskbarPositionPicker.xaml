<UserControl x:Class="GTweak.Assets.UserControls.TaskbarPositionPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" Height="32"
             x:Name="Root" SnapsToDevicePixels="True" UseLayoutRounding="True" BorderBrush="{StaticResource Brush_Separator}">
    <Grid Height="32">
        <Rectangle RadiusX="6" RadiusY="6" Stroke="{Binding BorderBrush, ElementName=Root}" StrokeThickness="1" Fill="{StaticResource Brush_Background_ComboBox}" IsHitTestVisible="False"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="12,0,10,0" VerticalAlignment="Center">
                <Grid Visibility="Hidden" IsHitTestVisible="False">
                    <TextBlock Text="{DynamicResource TaskbarPos_Left_intf}" FontSize="14px" FontFamily="{StaticResource Jura}"/>
                    <TextBlock Text="{DynamicResource TaskbarPos_Top_intf}" FontSize="14px" FontFamily="{StaticResource Jura}"/>
                    <TextBlock Text="{DynamicResource TaskbarPos_Right_intf}" FontSize="14px" FontFamily="{StaticResource Jura}"/>
                    <TextBlock Text="{DynamicResource TaskbarPos_Bottom_intf}" FontSize="14px" FontFamily="{StaticResource Jura}"/>
                </Grid>

                <TextBlock x:Name="PositionLabel" VerticalAlignment="Center" HorizontalAlignment="Left" FontSize="14px" FontFamily="{StaticResource Jura}" Foreground="{StaticResource Brush_Highlighted}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text" Value="{DynamicResource TaskbarPos_Bottom_intf}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="0">
                                    <Setter Property="Text" Value="{DynamicResource TaskbarPos_Left_intf}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="1">
                                    <Setter Property="Text" Value="{DynamicResource TaskbarPos_Top_intf}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="2">
                                    <Setter Property="Text" Value="{DynamicResource TaskbarPos_Right_intf}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="3">
                                    <Setter Property="Text" Value="{DynamicResource TaskbarPos_Bottom_intf}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <Grid Grid.Column="1" Width="40" Height="32" Margin="0,0,5,0">
                <Path Data="M 0,0 L 20,16 L 0,32 Z" Tag="0" Fill="Transparent" Cursor="Hand" ToolTip="{DynamicResource TaskbarPos_Left_intf}" MouseLeftButtonDown="Sector_MouseLeftButtonDown"/>
                <Path Data="M 0,0 L 40,0 L 20,16 Z" Tag="1" Fill="Transparent" Cursor="Hand" ToolTip="{DynamicResource TaskbarPos_Top_intf}" MouseLeftButtonDown="Sector_MouseLeftButtonDown"/>
                <Path Data="M 40,0 L 20,16 L 40,32 Z" Tag="2" Fill="Transparent" Cursor="Hand" ToolTip="{DynamicResource TaskbarPos_Right_intf}" MouseLeftButtonDown="Sector_MouseLeftButtonDown"/>
                <Path Data="M 0,32 L 40,32 L 20,16 Z" Tag="3" Fill="Transparent" Cursor="Hand" ToolTip="{DynamicResource TaskbarPos_Bottom_intf}" MouseLeftButtonDown="Sector_MouseLeftButtonDown"/>

                <Grid IsHitTestVisible="False">
                    <Rectangle Fill="{StaticResource Brush_Separator}" RadiusX="1.25" RadiusY="1.25" Width="2.5" Height="10" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                    <Rectangle Fill="{StaticResource Brush_Separator}" RadiusX="1.25" RadiusY="1.25" Width="12" Height="2.5" VerticalAlignment="Top" Margin="0,3,0,0"/>
                    <Rectangle Fill="{StaticResource Brush_Separator}" RadiusX="1.25" RadiusY="1.25" Width="2.5" Height="10" HorizontalAlignment="Right" Margin="0,0,3,0"/>
                    <Rectangle Fill="{StaticResource Brush_Separator}" RadiusX="1.25" RadiusY="1.25" Width="12" Height="2.5" VerticalAlignment="Bottom" Margin="0,0,0,3"/>

                    <Rectangle x:Name="PositionIndicator" Fill="{StaticResource Brush_Accent}" RadiusX="1.25" RadiusY="1.25" RenderTransformOrigin="0.5, 0.5">
                        <Rectangle.RenderTransform>
                            <ScaleTransform/>
                        </Rectangle.RenderTransform>
                        <Rectangle.Style>
                            <Style TargetType="Rectangle">
                                <Setter Property="VerticalAlignment" Value="Bottom"/>
                                <Setter Property="HorizontalAlignment" Value="Center"/>
                                <Setter Property="Width" Value="12"/>
                                <Setter Property="Height" Value="2.5"/>
                                <Setter Property="Margin" Value="0,0,0,3"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="0">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Left"/>
                                        <Setter Property="Width" Value="2.5"/>
                                        <Setter Property="Height" Value="10"/>
                                        <Setter Property="Margin" Value="3,0,0,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="1">
                                        <Setter Property="VerticalAlignment" Value="Top"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Width" Value="12"/>
                                        <Setter Property="Height" Value="2.5"/>
                                        <Setter Property="Margin" Value="0,3,0,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="2">
                                        <Setter Property="VerticalAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                        <Setter Property="Width" Value="2.5"/>
                                        <Setter Property="Height" Value="10"/>
                                        <Setter Property="Margin" Value="0,0,3,0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="3">
                                        <Setter Property="VerticalAlignment" Value="Bottom"/>
                                        <Setter Property="HorizontalAlignment" Value="Center"/>
                                        <Setter Property="Width" Value="12"/>
                                        <Setter Property="Height" Value="2.5"/>
                                        <Setter Property="Margin" Value="0,0,0,3"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Rectangle.Style>
                    </Rectangle>

                    <Grid Width="24" Height="16">
                        <Rectangle RadiusX="3" RadiusY="3" Stroke="{StaticResource Brush_Separator}" StrokeThickness="1.5"/>

                        <Rectangle x:Name="TaskbarIndicator" Fill="{StaticResource Brush_Accent}" RenderTransformOrigin="0.5, 0.5" RadiusX="1.5" RadiusY="1.5">
                            <Rectangle.RenderTransform>
                                <ScaleTransform/>
                            </Rectangle.RenderTransform>
                            <Rectangle.Style>
                                <Style TargetType="Rectangle">
                                    <Setter Property="VerticalAlignment" Value="Bottom"/>
                                    <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    <Setter Property="Height" Value="3"/>
                                    <Setter Property="Width" Value="Auto"/>
                                    <Setter Property="Margin" Value="2,0,2,2"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="0">
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalAlignment" Value="Left"/>
                                            <Setter Property="Height" Value="Auto"/>
                                            <Setter Property="Width" Value="3"/>
                                            <Setter Property="Margin" Value="2,2,0,2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="1">
                                            <Setter Property="VerticalAlignment" Value="Top"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="Height" Value="3"/>
                                            <Setter Property="Width" Value="Auto"/>
                                            <Setter Property="Margin" Value="2,2,2,0"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="2">
                                            <Setter Property="VerticalAlignment" Value="Stretch"/>
                                            <Setter Property="HorizontalAlignment" Value="Right"/>
                                            <Setter Property="Height" Value="Auto"/>
                                            <Setter Property="Width" Value="3"/>
                                            <Setter Property="Margin" Value="0,2,2,2"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Position, ElementName=Root}" Value="3">
                                            <Setter Property="VerticalAlignment" Value="Bottom"/>
                                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            <Setter Property="Height" Value="3"/>
                                            <Setter Property="Width" Value="Auto"/>
                                            <Setter Property="Margin" Value="2,0,2,2"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Rectangle.Style>
                        </Rectangle>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>