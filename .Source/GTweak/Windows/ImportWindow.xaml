<ui:FluentWindow x:Class="GTweak.Windows.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:anim="clr-namespace:GTweak.Animations"     
        xmlns:manager="clr-namespace:GTweak.Modules.Managers"     
        xmlns:local="clr-namespace:GTweak.Windows"
        mc:Ignorable="d" Icon="/GTweak.ico" Title="{DynamicResource title_import}" Background="Transparent" WindowStyle="None" IsTabStop="False" 
        SnapsToDevicePixels="True" UseLayoutRounding="True" ShowInTaskbar="False" KeyboardNavigation.TabNavigation="None" ExtendsContentIntoTitleBar="True" 
        WindowBackdropType="Mica" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" 
        Topmost="True"  SizeToContent="Width" MinHeight="170" MaxHeight="170" MinWidth="360" MaxWidth="520" ContentRendered="Window_ContentRendered">
    <Grid Background="{StaticResource Brush_Background}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBar" Grid.Row="0" Height="38" MouseDown="TitleBar_MouseDown" Background="Transparent">
            <DockPanel HorizontalAlignment="Left" LastChildFill="True" VerticalAlignment="Center" Margin="14,0,14,0">
                <ui:SymbolIcon Symbol="DocumentArrowDown20" FontSize="16" Foreground="{StaticResource Brush_Accent}" VerticalAlignment="Center"/>
                <TextBlock Text="{DynamicResource title_import}" Style="{StaticResource TextDefault}" FontSize="14" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </DockPanel>
        </Grid>

        <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{StaticResource Brush_Separator}" Opacity="0.4"/>

        <Grid Grid.Row="1">
            <Grid x:Name="PanelProgress" Margin="15,12,15,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0" Text="{DynamicResource file_import}" Foreground="{StaticResource Brush_Inactive}" FontFamily="{StaticResource Jura}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>

                    <Border Grid.Column="1" Background="{StaticResource Brush_Background_Card}" BorderBrush="{StaticResource Brush_Separator}" BorderThickness="1" CornerRadius="6" Padding="7,3">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="DocumentCheckmark20" FontSize="12" Foreground="{StaticResource Brush_Accent}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" x:Name="ImportedFile" FontFamily="{StaticResource Jura}" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Brush_Accent}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center" MaxWidth="260"/>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="SectionLabel" Grid.Column="0" VerticalAlignment="Bottom" FontFamily="{StaticResource Jura}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" Margin="0,0,10,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentSection, RelativeSource={RelativeSource AncestorType=local:ImportWindow}}" Value="{x:Static manager:JsonConfigManager+Section.Confidentiality}">
                                        <Setter Property="Text" Value="{DynamicResource rbtn_conf_main}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection, RelativeSource={RelativeSource AncestorType=local:ImportWindow}}" Value="{x:Static manager:JsonConfigManager+Section.Interface}">
                                        <Setter Property="Text" Value="{DynamicResource rbtn_int_main}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection, RelativeSource={RelativeSource AncestorType=local:ImportWindow}}" Value="{x:Static manager:JsonConfigManager+Section.Packages}">
                                        <Setter Property="Text" Value="{DynamicResource rbtn_app_main}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection, RelativeSource={RelativeSource AncestorType=local:ImportWindow}}" Value="{x:Static manager:JsonConfigManager+Section.Services}">
                                        <Setter Property="Text" Value="{DynamicResource rbtn_svc_main}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding CurrentSection, RelativeSource={RelativeSource AncestorType=local:ImportWindow}}" Value="{x:Static manager:JsonConfigManager+Section.System}">
                                        <Setter Property="Text" Value="{DynamicResource rbtn_sys_main}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <Grid Grid.Column="1" VerticalAlignment="Bottom">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" x:Name="PercentLabel" anim:NumberAnimation.Value="0" FontFamily="{StaticResource Jura}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource Brush_Accent}"/>
                        <TextBlock Grid.Column="1" Text="%" FontFamily="{StaticResource Jura}" FontSize="15" FontWeight="Medium" Foreground="{StaticResource Brush_Accent}" VerticalAlignment="Bottom" Margin="1,0,0,1"/>
                    </Grid>
                </Grid>

                <Grid Grid.Row="2" x:Name="ProgressTrack" Height="3" Margin="0,0,0,6">
                    <Border Background="{StaticResource Brush_Separator}" CornerRadius="1.5"/>
                    <Border x:Name="ProgressFill" HorizontalAlignment="Left" CornerRadius="1.5" Width="0" Background="{StaticResource Brush_Accent}"/>
                </Grid>

                <Grid Grid.Row="3" x:Name="SegmentsGrid" Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Height="2" CornerRadius="1" Background="{StaticResource Brush_Accent}"/>
                    <Border Grid.Column="2" Height="2" CornerRadius="1" Background="{StaticResource Brush_Separator}"/>
                    <Border Grid.Column="4" Height="2" CornerRadius="1" Background="{StaticResource Brush_Separator}"/>
                    <Border Grid.Column="6" Height="2" CornerRadius="1" Background="{StaticResource Brush_Separator}"/>
                    <Border Grid.Column="8" Height="2" CornerRadius="1" Background="{StaticResource Brush_Separator}"/>
                </Grid>

                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Grid.Column="0" Symbol="Info16" FontSize="12" Foreground="{StaticResource Brush_Inactive}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="{DynamicResource warn_hint_import}" Foreground="{StaticResource Brush_Inactive}" FontFamily="{StaticResource Jura}" FontSize="11" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                </Grid>
            </Grid>

            <StackPanel x:Name="PanelDone" Visibility="Collapsed" Opacity="0" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20">
                <Border Width="38" Height="38" CornerRadius="19" BorderBrush="{StaticResource Brush_Accent}" BorderThickness="1.5" HorizontalAlignment="Center" Margin="0,0,0,10">
                    <ui:SymbolIcon Symbol="Checkmark16" FontSize="16" Foreground="{StaticResource Brush_Accent}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <TextBlock Text="{DynamicResource done_import}" FontFamily="{StaticResource Jura}" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Brush_Highlighted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                <TextBlock Text="{DynamicResource done_hint_import}" FontFamily="{StaticResource Jura}" FontSize="11" Foreground="{StaticResource Brush_Inactive}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>